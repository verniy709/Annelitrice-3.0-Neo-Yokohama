<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Keep this file in its conditional load folder. The sequence completes each new behavior before defs are loaded. -->
    <Operation Class="PatchOperationSequence">
        <operations>
            <!-- Job list: add new empty values to all listed sleeves and gloves. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_NeoYokohama_LongLatexGloves_Left" or defName="Anneli_NeoYokohama_LongLatexGloves_Right" or defName="Anneli_Arm_PauldronC_Left" or defName="Anneli_Arm_PauldronC_Right" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Left" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Right"]/behaviors</xpath>
                <value>
                    <li>
                        <key>UseToilet</key>
                        <value />
                    </li>
                    <li>
                        <key>haveWildPoo</key>
                        <value />
                    </li>
                    <li>
                        <key>washHands</key>
                        <value />
                    </li>
                    <li>
                        <key>washPatient</key>
                        <value />
                    </li>
                    <li>
                        <key>RefillTub</key>
                        <value />
                    </li>
                    <li>
                        <key>RefillWater</key>
                        <value />
                    </li>
                    <li>
                        <key>clearBlockage</key>
                        <value />
                    </li>
                    <li>
                        <key>useWashBucket</key>
                        <value />
                    </li>
                    <li>
                        <key>washAtCell</key>
                        <value />
                    </li>
                    <li>
                        <key>cleanBedpan</key>
                        <value />
                    </li>
                    <li>
                        <key>takeShower</key>
                        <value />
                    </li>
                    <li>
                        <key>takeBath</key>
                        <value />
                    </li>
                    <li>
                        <key>UseHotTub</key>
                        <value />
                    </li>
                    <li>
                        <key>DBHGoSwimming</key>
                        <value />
                    </li>
                    <li>
                        <key>DBHUseSauna</key>
                        <value />
                    </li>
                </value>
            </li>
            <!-- Common link settings: only the new empty values. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_NeoYokohama_LongLatexGloves_Left" or defName="Anneli_NeoYokohama_LongLatexGloves_Right" or defName="Anneli_Arm_PauldronC_Left" or defName="Anneli_Arm_PauldronC_Right" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Left" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Right"]/behaviors/li/value[not(*)]</xpath>
                <value>
                    <linkedWithAction>true</linkedWithAction>
                    <type_originalDefName>NareisLib.HandTypeDef_Anneli_Arm_Generic</type_originalDefName>
                    <linkedActionSyncDelta>0.2</linkedActionSyncDelta>
                </value>
            </li>
            <!-- Texture settings: Anneli_Arm_PauldronC, both arms. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_Arm_PauldronC_Left" or defName="Anneli_Arm_PauldronC_Right"]/behaviors/li/value[not(exPath)]</xpath>
                <value>
                    <exPath>Anneli_Arms/PauldronC/</exPath>
                    <textures>
                        <li>Anneli_Arm_PauldronC</li>
                    </textures>
                </value>
            </li>
            <!-- Texture settings: Anneli_NeoYokohama_LongLatexGloves, both arms. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_NeoYokohama_LongLatexGloves_Left" or defName="Anneli_NeoYokohama_LongLatexGloves_Right"]/behaviors/li/value[not(exPath)]</xpath>
                <value>
                    <exPath>Anneli_Gloves/LongLatexGloves/</exPath>
                    <textures>
                        <li>Anneli_NeoYokohama_LongLatexGloves</li>
                    </textures>
                </value>
            </li>
            <!-- Texture settings: Anneli_NeoYokohama_SamuraiGauntlets, both arms. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_NeoYokohama_SamuraiGauntlets_Left" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Right"]/behaviors/li/value[not(exPath)]</xpath>
                <value>
                    <exPath>Anneli_Gloves/SamuraiGauntlets/</exPath>
                    <textures>
                        <li>Anneli_NeoYokohama_SamuraiGauntlets</li>
                    </textures>
                </value>
            </li>
            <!-- Arm link: Left. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_NeoYokohama_LongLatexGloves_Left" or defName="Anneli_Arm_PauldronC_Left" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Left"]/behaviors/li/value[not(textureLevelsName)]</xpath>
                <value>
                    <textureLevelsName>Anneli_Arm_Generic_Left</textureLevelsName>
                </value>
            </li>
            <!-- Arm link: Right. Existing complete values are excluded. -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/NareisLib.ActionDef[defName="Anneli_NeoYokohama_LongLatexGloves_Right" or defName="Anneli_Arm_PauldronC_Right" or defName="Anneli_NeoYokohama_SamuraiGauntlets_Right"]/behaviors/li/value[not(textureLevelsName)]</xpath>
                <value>
                    <textureLevelsName>Anneli_Arm_Generic_Right</textureLevelsName>
                </value>
            </li>
        </operations>
    </Operation>
</Patch>
